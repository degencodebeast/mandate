{
  "name": "mandate-x402-services",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone x402 mock services (flaky + reliable) used as test targets for the Mandate circuit breaker demo.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start:a": "tsx src/service-a.ts",
    "start:b": "tsx src/service-b.ts",
    "start:naive": "tsx src/naive-agent.ts",
    "dev:a": "tsx watch src/service-a.ts",
    "dev:b": "tsx watch src/service-b.ts"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.3.0",
    "@x402/core": "^2.21.0",
    "@x402/evm": "^2.21.0",
    "@x402/express": "^2.21.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
