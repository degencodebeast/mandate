# Backend URL for the Mandate Service. The dashboard sends Privy JWTs here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to your Privy app ID to enable Privy login. When unset, the dashboard
# shows a dev sign-in form that issues local HS256 test JWTs.
NEXT_PUBLIC_PRIVY_APP_ID=

# Required for the dev sign-in form to issue test tokens. Must match the
# PRIVY_VERIFICATION_KEY on the Mandate Service when MANDATE_ENV=test.
MANDATE_DEV_TOKEN_SECRET=test-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MANDATE_DEV_TOKEN_APP_ID=test-app-id
